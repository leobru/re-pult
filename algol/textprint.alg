_РRОСЕDURЕ ТЕХТРRINТ(А,НАЧАЛО,КОНЕЦ,ГРАНИЧНЫЙСИМВОЛ);
_VАLUЕ НАЧАЛО,ГРАНИЧНЫЙСИМВОЛ;
_INТЕGЕR _АRRАУ А;_INТЕGЕR НАЧАЛО,КОНЕЦ,ГРАНИЧНЫЙСИМВОЛ;
_СОММЕNТ ПЕЧАТАЕТСЯ ПОСЛЕДОВАТЕЛЬНОСТЬ ЛЮБЫХ СИМВОЛОВ, ЗАКОДИРОВАННЫХ 
ПОГОСТ‘У И СОДЕРЖАЩИХСЯ В ОДНОМЕРНОМ МАССИВЕ А ОТ А[НАЧАЛО] 
ДО А[КОНЕЦ]. ЕСЛИ В ИНТЕРВАЛЕ НАЧАЛО÷КОНЕЦ ВСТРЕТИТСЯ ГРАНИЧНЫЙСИМВОЛ, 
ТО ПЕЧАТЬ ОБОРВЕТСЯ НА НЕМ (ВКЛЮЧАЯ ЭТОТ СИМВОЛ). В ЭТОМ СЛУЧАЕ 
ФОРМАЛЬНОМУ ПАРАМЕТРУ КОНЕЦ ДОЛЖЕН СООТВЕТСТВОВАТЬ 
ФАКТИЧЕСКИЙ ПАРАМЕТР-ПЕРЕМЕННАЯ, И ЕЕ ЗНАЧЕНИЕ ПОСЛЕ ВЫХОДА ИЗ 
ПРОЦЕДУРЫ БУДЕТ РАВНО НОМЕРУ ПОСЛЕДНЕГО ОТПЕЧАТАННОГО 
ЭЛЕМЕНТА;
_ВЕGIN _INТЕGЕR К,S1,S2;_INТЕGЕR _АRRАУ В[1:4];
В[1]:=26;В[4]:=27;
_FОR К:=НАЧАЛО_SТЕР 1_UNТIL КОНЕЦ_DО _ВЕGIN 
В[2]:=31;В[3]:=27;S1:=А[К];
S2:=_IF S1=26_ТНЕN 1_ЕLSЕ _IF S1=27_ТНЕN 2_ЕLSЕ 
_IF S1=31_ТНЕN 3_ЕLSЕ _IF S1=124_ТНЕN 12_ЕLSЕ 0;
_IF S2=0_ТНЕN В[2]:=S1_ЕLSЕ В[3]:=S2;
_IF S1=ГРАНИЧНЫЙСИМВОЛ_ТНЕN _ВЕGIN КОНЕЦ:=К-1;_GО _ТО ВЫХОД_ЕND ;
ОUТРUТ(‘Т’,В[1])_ЕND ;
ВЫХОД:_ЕND ;


